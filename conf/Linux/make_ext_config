######################################################################
# Linux g++ for creation of shared libraries
######################################################################

CXX             =  ${MPI_CPP}
# -O3 to match conf/Linux/make_root_config: without it the ext/ libraries
# were built at -O0 while everything in src/ was optimised.
# -nilanjan@fnal.gov 09/23/2026
CXXFLAGS       += -g -O3 -fPIC -DUSE_MPI=1
LINKFLAGS      += -fPIC -shared -Wl,--export-dynamic
